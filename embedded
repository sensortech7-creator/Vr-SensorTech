      display: inline-block; padding: 16px 34px; font-size: 18px; font-weight: 700;
      color: #020617; background: #00F0FF; border: none; border-radius: 10px;
      cursor: pointer; box-shadow: 0 0 25px rgba(0, 240, 255, 0.5);
    }
    #hud-subtitle {
      position: absolute; bottom: 24px; left: 50%; transform: translateX(-50%);

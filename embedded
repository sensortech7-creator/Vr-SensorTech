  <script>
    // ============================================================================
    // GESTOR DE AUDIO Y SÍNTESIS DE VOZ CORREGIDO PARA META QUEST
    // ============================================================================
    window.SensorTechVR = {
      audioUnlocked: false,
      isSpeaking: false,
      preferredVoice: null,
      audioCtx: null,

      loadVoices: function() {
        if (!('speechSynthesis' in window)) return;
        const voices = window.speechSynthesis.getVoices();
        const codes = ['es-MX', 'es-419', 'es-US', 'es-CO', 'es-AR', 'es-CL'];
        for (let i = 0; i < codes.length; i++) {
          const found = voices.find(v => v.lang.toLowerCase() === codes[i].toLowerCase());
          if (found) { this.preferredVoice = found; return; }
        }
        const anyEs = voices.find(v => v.lang.toLowerCase().startsWith('es'));
        if (anyEs) this.preferredVoice = anyEs;
      },

      unlockAudio: function() {
        if (this.audioUnlocked) return;
        this.audioUnlocked = true;
        
        try {
          const AudioContextClass = window.AudioContext || window.webkitAudioContext;
          if (AudioContextClass) {
            this.audioCtx = new AudioContextClass();
            if (this.audioCtx.state === 'suspended') this.audioCtx.resume();
          }
        } catch (e) { console.warn("AudioContext no soportado"); }

        if ('speechSynthesis' in window) {
          this.loadVoices();
          window.speechSynthesis.cancel();
          // Forzar la activación del motor con un string corto y volumen mínimo
          const warmUp = new SpeechSynthesisUtterance('Iniciando sistema Sensor Tech');
          warmUp.volume = 0.01; 
          warmUp.lang = 'es-MX';
          window.speechSynthesis.speak(warmUp);
        }
      },

      speak: function(pointId, text) {
        if (!this.audioUnlocked) return;
        const subBox = document.getElementById('hud-subtitle');
        const subText = document.getElementById('hud-subtitle-text');
        if (subBox && subText) {
          subText.textContent = text;
          subBox.style.display = 'block';
        }
        this.isSpeaking = true;

        if (!('speechSynthesis' in window)) return;
        window.speechSynthesis.cancel();
        const u = new SpeechSynthesisUtterance(text);
        if (!this.preferredVoice) this.loadVoices();
        if (this.preferredVoice) {
          u.voice = this.preferredVoice;
          u.lang = this.preferredVoice.lang;
        } else {
          u.lang = 'es-MX';
        }
        u.rate = 1.0;
        u.pitch = 0.96;
        u.onend = () => { this.isSpeaking = false; };
        u.onerror = () => { this.isSpeaking = false; };
        window.speechSynthesis.speak(u);
      }
    };

    if ('speechSynthesis' in window) {
      window.speechSynthesis.onvoiceschanged = () => window.SensorTechVR.loadVoices();
    }

    // Escuchador para reanudar el contexto de audio al entrar a VR en Meta Quest
    window.addEventListener('DOMContentLoaded', () => {
      const scene = document.querySelector('a-scene');
      if (scene) {
        scene.addEventListener('enter-vr', function () {
          if (window.SensorTechVR.audioCtx && window.SensorTechVR.audioCtx.state === 'suspended') {
            window.SensorTechVR.audioCtx.resume();
          }
          if ('speechSynthesis' in window) {
            window.speechSynthesis.resume();
          }
        });
      }
    });

    // ============================================================================
    // RENDERIZADORES DE CANVAS 2D DE ALTA RESOLUCIÓN Y COMPONENTES
    // ============================================================================
    const drawCentralDashboardCanvas = function drawCentralDashboardCanvas(ctx, width, height, tick) {
	const bgGrad = ctx.createLinearGradient(0, 0, 0, height);
	bgGrad.addColorStop(0, "#040B16"); bgGrad.addColorStop(.5, "#071426"); bgGrad.addColorStop(1, "#030914");
	ctx.fillStyle = bgGrad; ctx.fillRect(0, 0, width, height);
	ctx.strokeStyle = "rgba(0, 240, 255, 0.05)"; ctx.lineWidth = 2;
	for (let x = 0; x < width; x += 64) { ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, height); ctx.stroke(); }
	for (let y = 0; y < height; y += 64) { ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(width, y); ctx.stroke(); }
	ctx.strokeStyle = "#00F0FF"; ctx.lineWidth = 6; ctx.strokeRect(16, 16, width - 32, height - 32);
	ctx.fillStyle = "rgba(10, 37, 74, 0.85)"; ctx.fillRect(28, 28, width - 56, 150);
	ctx.strokeStyle = "#00E5FF"; ctx.lineWidth = 3; ctx.strokeRect(28, 28, width - 56, 150);
	ctx.fillStyle = "#00F0FF"; ctx.font = "bold 52px \"Chakra Petch\", sans-serif";
	ctx.fillText("SENSORTECH AI · SERVIDOR CENTRAL DE MANTENIMIENTO PREDICTIVO", 64, 98);
	ctx.fillStyle = "#94A3B8"; ctx.font = "600 30px \"Plus Jakarta Sans\", sans-serif";
	ctx.fillText("PLANTA DE INYECCIÓN DE PLÁSTICO INDUSTRIA 4.0  |  NODOS ESP32 + BME280 ACTIVOS: 06/06  |  MODELO ML: RANDOM FOREST + LSTM v4.2", 64, 148);
	const pulse = .5 + .5 * Math.sin(tick * .25);
	ctx.fillStyle = `rgba(0, 230, 118, ${.25 + pulse * .35})`; ctx.fillRect(width - 420, 52, 360, 100);
	ctx.strokeStyle = "#00E676"; ctx.lineWidth = 3; ctx.strokeRect(width - 420, 52, 360, 100);
	ctx.fillStyle = "#00E676"; ctx.font = "bold 34px \"JetBrains Mono\", monospace";
	ctx.fillText("● TELEMETRÍA EN VIVO", width - 395, 114);
	const kpis = [
		{ label: "TEMPERATURA BARRIL", value: `${(218.4 + Math.sin(tick * .12) * 1.3).toFixed(1)} °C`, sub: "Rango nominal: 195°C - 225°C", color: "#00F0FF" },
		{ label: "VIBRACIÓN RMS", value: `${(1.82 + Math.cos(tick * .18) * .14).toFixed(2)} mm/s`, sub: "Umbral crítico ML: 4.50 mm/s", color: "#00E676" },
		{ label: "PRESIÓN / HUMEDAD", value: `1013 hPa · ${(41.5 + Math.sin(tick * .07) * .4).toFixed(1)}%`, sub: "Sensor BME280 I2C Calibrado", color: "#38BDF8" },
		{ label: "REDUCCIÓN MERMAS", value: "-38.4%  |  OEE 96.8%", sub: "Cero paros no programados", color: "#FBBF24" }
	];
	const cardW = 472; const cardH = 220;
	kpis.forEach((kpi, idx) => {
		const x = 28 + idx * (cardW + 24); const y = 205;
		ctx.fillStyle = "rgba(13, 28, 52, 0.92)"; ctx.fillRect(x, y, cardW, cardH);
		ctx.strokeStyle = kpi.color; ctx.lineWidth = 3; ctx.strokeRect(x, y, cardW, cardH);
		ctx.fillStyle = "#94A3B8"; ctx.font = "bold 24px \"Plus Jakarta Sans\", sans-serif"; ctx.fillText(kpi.label, x + 26, y + 52);
		ctx.fillStyle = kpi.color; ctx.font = "bold 54px \"JetBrains Mono\", monospace"; ctx.fillText(kpi.value, x + 26, y + 132);
		ctx.fillStyle = "#CBD5E1"; ctx.font = "500 24px \"Plus Jakarta Sans\", sans-serif"; ctx.fillText(kpi.sub, x + 26, y + 186);
	});
	const leftX = 28; const leftY = 455; const leftW = 1260; const leftH = 790;
	ctx.fillStyle = "rgba(9, 22, 42, 0.94)"; ctx.fillRect(leftX, leftY, leftW, leftH);
	ctx.strokeStyle = "#1E40AF"; ctx.lineWidth = 4; ctx.strokeRect(leftX, leftY, leftW, leftH);
	ctx.fillStyle = "#F8FAFC"; ctx.font = "bold 36px \"Chakra Petch\", sans-serif";
	ctx.fillText("1. CURVA TÉRMICA DEL CILINDRO DE INYECCIÓN Y PREDICCIÓN HORIZONTE ML (°C)", leftX + 32, leftY + 56);
	const plotX = leftX + 95; const plotY = leftY + 140; const plotW = leftW - 140; const plotH = 570;
	ctx.fillStyle = "#040D1A"; ctx.fillRect(plotX, plotY, plotW, plotH);
	ctx.strokeStyle = "#1E293B"; ctx.lineWidth = 2; ctx.strokeRect(plotX, plotY, plotW, plotH);
	const tempLevels = [250, 240, 225, 210, 195, 180];
	tempLevels.forEach((temp) => {
		const ratio = (250 - temp) / (250 - 180); const y = plotY + ratio * plotH;
		ctx.strokeStyle = temp === 240 ? "rgba(239, 68, 68, 0.8)" : "rgba(148, 163, 184, 0.18)"; ctx.lineWidth = temp === 240 ? 3 : 1.5;
		ctx.beginPath(); ctx.moveTo(plotX, y); ctx.lineTo(plotX + plotW, y); ctx.stroke();
		ctx.fillStyle = temp === 240 ? "#EF4444" : "#94A3B8"; ctx.font = "bold 22px \"JetBrains Mono\", monospace"; ctx.fillText(`${temp}°C`, leftX + 18, y + 8);
	});
	const y225 = plotY + (250 - 225) / 70 * plotH; const y195 = plotY + (250 - 195) / 70 * plotH;
	ctx.fillStyle = "rgba(0, 230, 118, 0.08)"; ctx.fillRect(plotX, y225, plotW, y195 - y225);
	ctx.strokeStyle = "#00F0FF"; ctx.lineWidth = 5; ctx.beginPath();
	const splitIndex = 36; const totalPoints = 50;
	for (let i = 0; i <= splitIndex; i++) {
		const px = plotX + i / totalPoints * plotW;
		const tempVal = 214 + Math.sin((i + tick * .4) * .22) * 5.5 + Math.cos((i - tick * .2) * .45) * 2.4;
		const py = plotY + (250 - tempVal) / 70 * plotH;
		if (i === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
	}
	ctx.stroke();
	ctx.save(); ctx.setLineDash([12, 8]); ctx.strokeStyle = "#FBBF24"; ctx.lineWidth = 5; ctx.beginPath();
	for (let i = splitIndex; i <= totalPoints; i++) {
		const px = plotX + i / totalPoints * plotW; const progress = (i - splitIndex) / (totalPoints - splitIndex);
		const predictedTemp = 217 + progress * 15.5 + Math.sin((i + tick * .4) * .25) * 3.8;
		const py = plotY + (250 - predictedTemp) / 70 * plotH;
		if (i === splitIndex) ctx.moveTo(px, py); else ctx.lineTo(px, py);
	}
	ctx.stroke(); ctx.restore();
	const alertX = plotX + 41 / totalPoints * plotW - 190; const alertY = plotY + 55;
	ctx.fillStyle = "rgba(245, 158, 11, 0.22)"; ctx.fillRect(alertX, alertY, 390, 74);
	ctx.strokeStyle = "#F59E0B"; ctx.lineWidth = 3; ctx.strokeRect(alertX, alertY, 390, 74);
	ctx.fillStyle = "#FDE68A"; ctx.font = "bold 23px \"JetBrains Mono\", monospace";
	ctx.fillText("⚠ ALERTA TEMPRANA IA: +14°C", alertX + 18, alertY + 32);
	const rightX = 1312; const rightY = 455; const rightW = 708; const rightH = 790;
	ctx.fillStyle = "rgba(9, 22, 42, 0.94)"; ctx.fillRect(rightX, rightY, rightW, rightH);
	ctx.strokeStyle = "#00F0FF"; ctx.lineWidth = 4; ctx.strokeRect(rightX, rightY, rightW, rightH);
	ctx.fillStyle = "#F8FAFC"; ctx.font = "bold 34px \"Chakra Petch\", sans-serif";
	ctx.fillText("2. ESTADO DE MÁQUINAS", rightX + 28, rightY + 56);
	const machines = [
		{ id: "INY-01", temp: "215.2°C", vib: "1.41 mm/s", amp: "39.8 A", rul: "98%", status: "ÓPTIMO", col: "#00E676" },
		{ id: "INY-02", temp: "218.4°C", vib: "1.84 mm/s", amp: "42.6 A", rul: "94%", status: "MONITOREADO", col: "#00F0FF" },
		{ id: "INY-03", temp: "229.8°C", vib: "3.12 mm/s", amp: "47.1 A", rul: "79%", status: "PREDICCIÓN", col: "#FBBF24" },
		{ id: "INY-04", temp: "214.0°C", vib: "1.29 mm/s", amp: "38.4 A", rul: "99%", status: "ÓPTIMO", col: "#00E676" },
		{ id: "INY-05", temp: "216.7°C", vib: "1.52 mm/s", amp: "40.2 A", rul: "97%", status: "ÓPTIMO", col: "#00E676" },
		{ id: "INY-06", temp: "215.9°C", vib: "1.38 mm/s", amp: "39.1 A", rul: "98%", status: "ÓPTIMO", col: "#00E676" }
	];
	machines.forEach((m, idx) => {
		const my = rightY + 92 + idx * 110;
		ctx.fillStyle = idx === 1 || idx === 2 ? "rgba(30, 58, 138, 0.45)" : "rgba(15, 23, 42, 0.8)";
		ctx.fillRect(rightX + 24, my, rightW - 48, 94);
		ctx.strokeStyle = m.col; ctx.lineWidth = 2.5; ctx.strokeRect(rightX + 24, my, rightW - 48, 94);
		ctx.fillStyle = "#FFFFFF"; ctx.font = "bold 25px \"JetBrains Mono\", monospace"; ctx.fillText(m.id, rightX + 42, my + 36);
		ctx.fillStyle = m.col; ctx.font = "bold 23px \"JetBrains Mono\", monospace"; ctx.fillText(`[${m.status}]`, rightX + 440, my + 36);
		ctx.fillStyle = "#CBD5E1"; ctx.font = "22px \"JetBrains Mono\", monospace"; ctx.fillText(`T:${m.temp} | Vib:${m.vib}`, rightX + 42, my + 74);
	});
	const botY = 1270; const botH = 745;
	ctx.fillStyle = "rgba(9, 22, 42, 0.94)"; ctx.fillRect(leftX, botY, 1e3, botH);
	ctx.strokeStyle = "#1E40AF"; ctx.lineWidth = 4; ctx.strokeRect(leftX, botY, 1e3, botH);
	ctx.fillStyle = "#F8FAFC"; ctx.font = "bold 34px \"Chakra Petch\", sans-serif";
	ctx.fillText("3. ANÁLISIS ESPECTRAL (FFT)", leftX + 32, botY + 54);
	const barAreaX = leftX + 60; const barAreaY = botY + 135; const barAreaW = 890; const barAreaH = 540;
	ctx.fillStyle = "#040D1A"; ctx.fillRect(barAreaX, barAreaY, barAreaW, barAreaH);
	const numBars = 28; const barW = Math.floor(barAreaW / numBars) - 8;
	for (let b = 0; b < numBars; b++) {
		const bx = barAreaX + 12 + b * (barW + 8);
		const isAnomalyBand = b === 17 || b === 18;
		const wave = Math.abs(Math.sin(b * .45 + tick * .25)) * .45 + (isAnomalyBand ? .42 : .15);
		const bh = Math.min(barAreaH - 40, Math.max(36, wave * barAreaH));
		const by = barAreaY + barAreaH - bh;
		ctx.fillStyle = isAnomalyBand ? "#F59E0B" : b > 21 ? "#38BDF8" : "#00F0FF";
		ctx.fillRect(bx, by, barW, bh);
	}
	const mlX = 1052; const mlW = 968;
	ctx.fillStyle = "rgba(9, 22, 42, 0.94)"; ctx.fillRect(mlX, botY, mlW, botH);
	ctx.strokeStyle = "#00E676"; ctx.lineWidth = 4; ctx.strokeRect(mlX, botY, mlW, botH);
	ctx.fillStyle = "#00E676"; ctx.font = "bold 36px \"Chakra Petch\", sans-serif";
	ctx.fillText("4. INTELIGENCIA ARTIFICIAL", mlX + 32, botY + 56);
	const insights = [
		{ title: "DIAGNÓSTICO EN TIEMPO REAL", desc: "Fusión de datos BME280 + Vibración." },
		{ title: "ALERTA PRE-FALLA", desc: "Desviación térmica detectada." },
		{ title: "IMPACTO OPERATIVO", desc: "Reducción de mermas en 38.4%." },
		{ title: "ARQUITECTURA CLOUD", desc: "Inferencia vía MQTT/TLS." }
	];
	insights.forEach((item, idx) => {
		const iy = botY + 95 + idx * 152;
		ctx.fillStyle = "rgba(15, 35, 66, 0.85)"; ctx.fillRect(mlX + 32, iy, mlW - 64, 132);
		ctx.strokeStyle = idx === 1 ? "#FBBF24" : "#00F0FF"; ctx.lineWidth = 2; ctx.strokeRect(mlX + 32, iy, mlW - 64, 132);
		ctx.fillStyle = idx === 1 ? "#FBBF24" : "#00F0FF"; ctx.font = "bold 26px \"Chakra Petch\", sans-serif";
		ctx.fillText(`▸ ${item.title}`, mlX + 54, iy + 46);
		ctx.fillStyle = "#E2E8F0"; ctx.font = "24px \"Plus Jakarta Sans\", sans-serif";
		ctx.fillText(item.desc, mlX + 54, iy + 94);
	});
};
    const drawIoTNodeCanvas = function drawIoTNodeCanvas(ctx, width, height, tick) {
	ctx.fillStyle = "#050E1D"; ctx.fillRect(0, 0, width, height);
	ctx.strokeStyle = "#00F0FF"; ctx.lineWidth = 8; ctx.strokeRect(12, 12, width - 24, height - 24);
	ctx.fillStyle = "#0A254A"; ctx.fillRect(24, 24, width - 48, 130);
	ctx.fillStyle = "#00F0FF"; ctx.font = "bold 42px \"Chakra Petch\", sans-serif";
	ctx.fillText("NODO IOT ESTACIÓN #02", 48, 82);
	const temp = (218.4 + Math.sin(tick * .2) * .9).toFixed(1);
	const pres = (1013.2 + Math.cos(tick * .1) * .4).toFixed(1);
	const hum = (41.2 + Math.sin(tick * .15) * .3).toFixed(1);
	const vib = (1.84 + Math.cos(tick * .25) * .12).toFixed(2);
	const amp = (42.6 + Math.sin(tick * .3) * .8).toFixed(1);
	const rows = [
		{ name: "TEMPERATURA", val: `${temp} °C`, status: "NOMINAL", col: "#00F0FF" },
		{ name: "PRESIÓN BAROMÉTRICA", val: `${pres} hPa`, status: "ESTABLE", col: "#38BDF8" },
		{ name: "HUMEDAD RELATIVA", val: `${hum} %`, status: "SECO OK", col: "#00E676" },
		{ name: "VIBRACIÓN RMS", val: `${vib} mm/s`, status: "BAJA VIB", col: "#00E676" },
		{ name: "CORRIENTE MOTOR", val: `${amp} A`, status: "CARGA NORMAL", col: "#FBBF24" }
	];
	rows.forEach((r, idx) => {
		const y = 180 + idx * 130;
		ctx.fillStyle = "#0B1B33"; ctx.fillRect(36, y, width - 72, 112);
		ctx.strokeStyle = r.col; ctx.lineWidth = 3; ctx.strokeRect(36, y, width - 72, 112);
		ctx.fillStyle = "#CBD5E1"; ctx.font = "bold 26px \"Plus Jakarta Sans\", sans-serif"; ctx.fillText(r.name, 60, y + 42);
		ctx.fillStyle = r.col; ctx.font = "bold 44px \"JetBrains Mono\", monospace"; ctx.fillText(r.val, 60, y + 92);
		ctx.fillStyle = r.col; ctx.font = "bold 26px \"JetBrains Mono\", monospace"; ctx.fillText(`● ${r.status}`, width - 310, y + 70);
	});
	const waveY = 845;
	ctx.fillStyle = "#030812"; ctx.fillRect(36, waveY, width - 72, 145);
	ctx.strokeStyle = "#1E3A8A"; ctx.lineWidth = 2; ctx.strokeRect(36, waveY, width - 72, 145);
	ctx.strokeStyle = "#00E676"; ctx.lineWidth = 4; ctx.beginPath();
	for (let i = 0; i <= 60; i++) {
		const wx = 48 + i / 60 * (width - 96);
		const wy = waveY + 72 + Math.sin(i * .4 + tick * .5) * 38 * Math.cos(i * .15);
		if (i === 0) ctx.moveTo(wx, wy); else ctx.lineTo(wx, wy);
	}
	ctx.stroke();
};

    AFRAME.registerComponent('follow-player', {
      schema: { distance: { type: 'number', default: 1.5 }, sideOffset: { type: 'number', default: 0.68 }, heightOffset: { type: 'number', default: 0.02 }, lerpFactor: { type: 'number', default: 0.04 } },
      init: function () {

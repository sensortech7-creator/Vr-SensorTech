    }
    .logo-highlight { color: #00F0FF; }
    .subtitle {
      font-size: 18px;
      color: #38BDF8;
      font-weight: 600;
      letter-spacing: 2px;
      margin-bottom: 30px;
      text-transform: uppercase;
    }
    .about-text {
      font-size: 16px;
      line-height: 1.8;
      color: #CBD5E1;

    /* --- CONTENEDOR DE REALIDAD VIRTUAL --- */
    #vr-section {
      width: 100%;
      height: 85vh;
      position: relative;
      background: #000;
    }
    
    #vr-start-overlay {
      position: absolute; inset: 0; z-index: 99999;
      background: radial-gradient(circle at 50% 35%, rgba(10, 61, 145, 0.92), rgba(2, 6, 23, 0.98));
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      padding: 24px; text-align: center; cursor: pointer; transition: opacity 0.35s ease;
    }
    .overlay-box {
      max-width: 680px; width: 100%; padding: 40px 32px;
      background: rgba(15, 23, 42, 0.85); border: 2px solid #00F0FF; border-radius: 16px;
